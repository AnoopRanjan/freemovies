@model CinePulse.Mvc.Models.HomeViewModel

@{
    ViewBag.Title = "Stream Free Movies, Trailers & Cinema Booking";
    var featured = Model.FeaturedMovie;
}

<!-- Hero Banner Section with Original Cinematic Backdrop -->
@if (featured != null)
{
    <section class="relative w-full h-[65vh] min-h-[480px] max-h-[720px] overflow-hidden bg-black">
        <!-- Wide Cinematic Backdrop Image -->
        <div class="absolute inset-0">
            <img src="@featured.BackdropUrl" 
                 alt="@featured.Title Backdrop" 
                 class="w-full h-full object-cover object-center filter brightness-90 transform scale-100 animate-fade-in" />
            <div class="absolute inset-0 hero-vignette"></div>
        </div>

        <!-- Hero Content Overlay -->
        <div class="relative max-w-7xl mx-auto h-full px-4 sm:px-6 lg:px-8 flex flex-col justify-end pb-12 z-20">
            <div class="max-w-2xl space-y-4">
                
                <!-- Category Badges -->
                <div class="flex items-center gap-2 flex-wrap">
                    <span class="px-2.5 py-1 bg-red-600 text-white font-black text-xs rounded uppercase tracking-wider flex items-center gap-1.5 shadow-lg shadow-red-950/40">
                        <i class="fa-solid fa-fire text-amber-300"></i> Featured Blockbuster
                    </span>
                    <span class="px-2 py-0.5 bg-black/60 backdrop-blur-md text-amber-400 font-bold text-xs rounded border border-amber-400/30 flex items-center gap-1">
                        <i class="fa-solid fa-star"></i> @featured.ImdbRating.ToString("0.0") IMDb
                    </span>
                    <span class="px-2 py-0.5 bg-black/60 backdrop-blur-md text-slate-300 font-medium text-xs rounded border border-slate-700/50">
                        @featured.ReleaseYear
                    </span>
                    <span class="px-2 py-0.5 bg-black/60 backdrop-blur-md text-slate-300 font-medium text-xs rounded border border-slate-700/50">
                        @featured.AgeRating
                    </span>
                    <span class="px-2 py-0.5 bg-black/60 backdrop-blur-md text-slate-300 font-medium text-xs rounded border border-slate-700/50">
                        @featured.DurationMinutes min
                    </span>
                </div>

                <!-- Title & Tagline -->
                <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight drop-shadow-md leading-tight">
                    @featured.Title
                </h1>
                
                @if (!string.IsNullOrEmpty(featured.Tagline))
                {
                    <p class="text-amber-300 font-medium text-sm sm:text-base italic drop-shadow">
                        "@featured.Tagline"
                    </p>
                }

                <p class="text-slate-300 text-xs sm:text-sm line-clamp-3 leading-relaxed drop-shadow">
                    @featured.Description
                </p>

                <!-- Hero Action Buttons -->
                <div class="flex items-center gap-3 pt-2 flex-wrap">
                    <!-- In-app watch button -->
                    <a href="~/watch/@featured.Id" 
                       class="px-6 py-2.5 bg-red-600 hover:bg-red-700 text-white font-bold rounded-lg text-sm flex items-center gap-2 shadow-lg shadow-red-900/50 transition-all hover:scale-105">
                        <i class="fa-solid fa-play text-xs"></i> Watch Free Movie
                    </a>

                    <!-- Direct YouTube watch in new tab -->
                    @if (!string.IsNullOrEmpty(featured.YouTubeVideoId))
                    {
                        <a href="@featured.DirectYouTubeWatchUrl" 
                           target="_blank" 
                           rel="noopener noreferrer"
                           class="px-5 py-2.5 bg-slate-900/80 hover:bg-slate-800 text-slate-100 border border-slate-700 font-semibold rounded-lg text-sm flex items-center gap-2 backdrop-blur-md transition-all hover:scale-105">
                            <i class="fa-brands fa-youtube text-red-500 text-base"></i> Watch in New Tab
                            <i class="fa-solid fa-arrow-up-right-from-square text-[10px] text-slate-400"></i>
                        </a>
                    }

                    <a href="~/trailers" 
                       class="px-4 py-2.5 bg-white/10 hover:bg-white/20 text-slate-200 border border-white/20 font-medium rounded-lg text-sm flex items-center gap-2 backdrop-blur-md transition-colors">
                        <i class="fa-solid fa-film text-xs text-amber-400"></i> Browse Trailers
                    </a>
                </div>

            </div>
        </div>
    </section>
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 py-10">

    <!-- Continue Watching Rail (Personalized) -->
    @if (Model.ContinueWatching != null && Model.ContinueWatching.Any())
    {
        <section class="space-y-4">
            <div class="flex items-center justify-between">
                <h2 class="text-lg sm:text-xl font-bold text-white flex items-center gap-2">
                    <i class="fa-solid fa-circle-play text-red-500"></i> Continue Watching for Priya
                </h2>
                <a href="~/Account/Profile" class="text-xs text-slate-400 hover:text-white transition-colors">
                    Manage History <i class="fa-solid fa-chevron-right text-[10px]"></i>
                </a>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                @foreach (var cw in Model.ContinueWatching)
                {
                    <div class="bg-brand-card border border-brand-border rounded-lg p-3 flex gap-3 items-center group hover:border-slate-600 transition-colors">
                        <img src="@cw.MoviePoster" alt="@cw.MovieTitle" class="w-16 h-24 object-cover rounded shadow" />
                        <div class="flex-grow space-y-2">
                            <h4 class="font-bold text-xs text-white group-hover:text-red-400 line-clamp-1">@cw.MovieTitle</h4>
                            
                            <!-- Progress Bar -->
                            <div class="w-full bg-slate-800 rounded-full h-1.5 overflow-hidden">
                                <div class="bg-red-600 h-full rounded-full" style="width: @cw.ProgressPercentage%"></div>
                            </div>
                            <div class="flex items-center justify-between text-[10px] text-slate-400">
                                <span>@(cw.ProgressSeconds / 60)m left</span>
                                <span>@cw.ProgressPercentage.ToString("0")%</span>
                            </div>

                            <a href="~/watch/@cw.MovieId" class="inline-flex items-center gap-1 text-[11px] text-red-400 hover:text-red-300 font-semibold">
                                <i class="fa-solid fa-play text-[9px]"></i> Resume
                            </a>
                        </div>
                    </div>
                }
            </div>
        </section>
    }

    <!-- 1. Dedicated "Must Watch" Bollywood Blockbusters Rail -->
    <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-3">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-red-600/20 border border-red-500/40 flex items-center justify-center text-red-500">
                    <i class="fa-solid fa-fire text-sm"></i>
                </div>
                <div>
                    <h2 class="text-xl sm:text-2xl font-black text-white tracking-tight flex items-center gap-2">
                        Must Watch Bollywood
                        <span class="text-xs px-2 py-0.5 bg-gradient-to-r from-red-600 to-amber-600 text-white font-bold rounded-full uppercase tracking-wider shadow">
                            Curated Free Full Movies
                        </span>
                    </h2>
                    <p class="text-xs text-slate-400">
                        Top Indian blockbusters available legally in 1080p FHD with zero playback errors. Watch in-app or open in a new tab.
                    </p>
                </div>
            </div>

            <a href="~/must-watch" class="text-xs font-bold text-amber-400 hover:text-amber-300 transition-colors flex items-center gap-1 bg-amber-500/10 hover:bg-amber-500/20 px-3 py-1.5 rounded-lg border border-amber-500/30">
                Explore All (@Model.MustWatchMovies.Count) <i class="fa-solid fa-arrow-right text-[10px]"></i>
            </a>
        </div>

        <!-- Movie Cards Grid -->
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var movie in Model.MustWatchMovies.Take(6))
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    </section>

    <!-- 2. Trending Now (Unified Bollywood, Hollywood, South Indian Cinema) -->
    <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
            <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-bolt text-amber-400"></i> Trending Now
            </h2>
            <span class="text-xs text-slate-400">Unified Global & Indian Catalogue</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var movie in Model.Trending.Take(6))
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    </section>

    <!-- 3. Free Full Movies (Official Channels) -->
    <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
            <div>
                <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                    <i class="fa-brands fa-youtube text-red-500"></i> Free Full Movies
                </h2>
                <p class="text-xs text-slate-400">100% Legal Streaming from Official Production Houses & Studio Channels</p>
            </div>
            <a href="~/Movies/Free" class="text-xs font-semibold text-slate-300 hover:text-white flex items-center gap-1">
                View All Free <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var movie in Model.FreeMovies.Skip(6).Take(6))
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    </section>

    <!-- 4. Top Rated Cinema -->
    <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
            <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                <i class="fa-solid fa-trophy text-amber-400"></i> Highest Rated Masterpieces
            </h2>
            <span class="text-xs text-slate-400">IMDb 8.0+ Rated</span>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var movie in Model.TopRated.Take(6))
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    </section>

    <!-- 5. Premium Cinema (Rentals & 4K UHD Purchases) -->
    <section class="space-y-4">
        <div class="flex items-center justify-between border-b border-slate-800/80 pb-2">
            <div>
                <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
                    <i class="fa-solid fa-crown text-amber-400"></i> Premium OTT & 4K UHD Rentals
                </h2>
                <p class="text-xs text-slate-400">Latest theatrical releases available for digital rental from ₹49</p>
            </div>
            <a href="~/Movies/Premium" class="text-xs font-semibold text-amber-400 hover:text-amber-300 flex items-center gap-1">
                Rent & Buy Hub <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var movie in Model.PremiumMovies.Take(6))
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    </section>

    <!-- 6. Browse By Genre Tiles -->
    <section class="space-y-4">
        <h2 class="text-xl font-black text-white tracking-tight flex items-center gap-2">
            <i class="fa-solid fa-compass text-sky-400"></i> Browse by Genre
        </h2>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-3">
            <a href="~/Movies/Free?genre=Action" class="p-4 bg-brand-card hover:bg-slate-800 border border-brand-border hover:border-red-500/50 rounded-lg flex items-center gap-3 transition-all group">
                <i class="fa-solid fa-fire text-red-500 text-xl group-hover:scale-110 transition-transform"></i>
                <div>
                    <h4 class="font-bold text-sm text-white">Action</h4>
                    <span class="text-[10px] text-slate-400">Blockbusters</span>
                </div>
            </a>
            <a href="~/Movies/Free?genre=Comedy" class="p-4 bg-brand-card hover:bg-slate-800 border border-brand-border hover:border-amber-500/50 rounded-lg flex items-center gap-3 transition-all group">
                <i class="fa-solid fa-face-laugh-squint text-amber-400 text-xl group-hover:scale-110 transition-transform"></i>
                <div>
                    <h4 class="font-bold text-sm text-white">Comedy</h4>
                    <span class="text-[10px] text-slate-400">Laughter & Fun</span>
                </div>
            </a>
            <a href="~/Movies/Free?genre=Romance" class="p-4 bg-brand-card hover:bg-slate-800 border border-brand-border hover:border-rose-500/50 rounded-lg flex items-center gap-3 transition-all group">
                <i class="fa-solid fa-heart text-rose-500 text-xl group-hover:scale-110 transition-transform"></i>
                <div>
                    <h4 class="font-bold text-sm text-white">Romance</h4>
                    <span class="text-[10px] text-slate-400">Evergreen Love</span>
                </div>
            </a>
            <a href="~/Movies/Free?genre=Thriller" class="p-4 bg-brand-card hover:bg-slate-800 border border-brand-border hover:border-indigo-500/50 rounded-lg flex items-center gap-3 transition-all group">
                <i class="fa-solid fa-bolt text-indigo-400 text-xl group-hover:scale-110 transition-transform"></i>
                <div>
                    <h4 class="font-bold text-sm text-white">Thriller</h4>
                    <span class="text-[10px] text-slate-400">Edge of Seat</span>
                </div>
            </a>
            <a href="~/Movies/Free?genre=Regional%20Cinema" class="p-4 bg-brand-card hover:bg-slate-800 border border-brand-border hover:border-emerald-500/50 rounded-lg flex items-center gap-3 transition-all group">
                <i class="fa-solid fa-globe text-emerald-400 text-xl group-hover:scale-110 transition-transform"></i>
                <div>
                    <h4 class="font-bold text-sm text-white">Pan-India</h4>
                    <span class="text-[10px] text-slate-400">Telugu, Tamil, Mal</span>
                </div>
            </a>
        </div>
    </section>

</div>
