@model CinePulse.Mvc.Models.UserProfile

@{
    ViewBag.Title = "My Profile & Privacy Settings";
    var watchlistMovies = ViewBag.WatchlistMovies as List<CinePulse.Mvc.Models.Movie> ?? new List<CinePulse.Mvc.Models.Movie>();
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- User Card -->
    <div class="bg-brand-card border border-brand-border rounded-2xl p-6 sm:p-8 flex flex-col md:flex-row items-center md:items-start gap-6 shadow-xl">
        <div class="relative">
            <img src="@Model.AvatarUrl" alt="@Model.DisplayName" class="w-24 h-24 rounded-full object-cover ring-2 ring-red-500 shadow-lg" />
            <span class="absolute bottom-1 right-1 w-4 h-4 rounded-full bg-emerald-500 ring-2 ring-brand-card"></span>
        </div>

        <div class="space-y-3 flex-grow text-center md:text-left">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3">
                <div>
                    <h1 class="text-2xl sm:text-3xl font-black text-white">@Model.DisplayName</h1>
                    <p class="text-xs text-slate-400 mt-0.5">
                        <i class="fa-brands fa-google text-red-500 mr-1"></i> @Model.Email &nbsp;•&nbsp; Authenticated via Google OAuth 2.0
                    </p>
                </div>

                <!-- VIP Status Badge -->
                @if (Model.IsVip)
                {
                    <span class="px-3 py-1.5 bg-gradient-to-r from-amber-500 to-red-600 text-slate-950 font-black text-xs rounded-full uppercase tracking-wider shadow">
                        <i class="fa-solid fa-crown mr-1"></i> VIP Member (@Model.VipPlan)
                    </span>
                }
                else
                {
                    <form action="~/Account/UpgradeVip" method="post">
                        <button type="submit" class="px-4 py-2 bg-gradient-to-r from-red-600 to-amber-600 hover:from-red-700 hover:to-amber-700 text-white font-bold rounded-lg text-xs shadow transition-all">
                            <i class="fa-solid fa-crown mr-1 text-amber-300"></i> Upgrade to Ad-Free VIP
                        </button>
                    </form>
                }
            </div>

            <!-- Preferences Tags -->
            <div class="flex items-center gap-2 flex-wrap pt-2 justify-center md:justify-start text-xs text-slate-300">
                <span class="text-slate-400 font-semibold mr-1">Favorite Genres:</span>
                @foreach (var g in Model.FavoriteGenres)
                {
                    <span class="px-2.5 py-0.5 bg-slate-900 border border-slate-700 rounded-full text-[11px] text-slate-300">@g</span>
                }
            </div>
            
            <div class="flex items-center gap-2 flex-wrap justify-center md:justify-start text-xs text-slate-300">
                <span class="text-slate-400 font-semibold mr-1">Favorite Stars:</span>
                @foreach (var a in Model.FavoriteActors)
                {
                    <span class="px-2.5 py-0.5 bg-red-950/60 border border-red-800/60 rounded-full text-[11px] text-red-300">@a</span>
                }
            </div>
        </div>
    </div>

    <!-- Quick Stats -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-center">
        <div class="bg-brand-card border border-brand-border rounded-xl p-4">
            <span class="text-2xl font-black text-white">@Model.Watchlist.Count</span>
            <p class="text-xs text-slate-400 mt-1">Saved to Watchlist</p>
        </div>
        <div class="bg-brand-card border border-brand-border rounded-xl p-4">
            <span class="text-2xl font-black text-white">@Model.ContinueWatching.Count</span>
            <p class="text-xs text-slate-400 mt-1">Active Streams in Progress</p>
        </div>
        <div class="bg-brand-card border border-brand-border rounded-xl p-4">
            <span class="text-2xl font-black text-emerald-400">100%</span>
            <p class="text-xs text-slate-400 mt-1">Privacy & Data Protected</p>
        </div>
    </div>

    <!-- Watchlist Preview -->
    <div class="space-y-4">
        <div class="flex items-center justify-between">
            <h2 class="text-xl font-bold text-white flex items-center gap-2">
                <i class="fa-regular fa-bookmark text-red-500"></i> My Saved Watchlist (@watchlistMovies.Count)
            </h2>
            <a href="~/Account/Watchlist" class="text-xs text-red-400 hover:text-red-300 font-semibold">
                View Full Watchlist <i class="fa-solid fa-chevron-right text-[10px]"></i>
            </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var m in watchlistMovies.Take(6))
            {
                @Html.Partial("_MovieCard", m)
            }
        </div>
    </div>

    <!-- Privacy & Account Controls (GDPR / DPDP Compliance) -->
    <div class="bg-brand-card border border-brand-border rounded-xl p-6 space-y-4">
        <h3 class="font-bold text-sm uppercase tracking-wider text-slate-200 flex items-center gap-2">
            <i class="fa-solid fa-shield-halved text-amber-400"></i> Privacy Rights & Account Governance
        </h3>
        <p class="text-xs text-slate-400 leading-relaxed max-w-2xl">
            In compliance with India's Digital Personal Data Protection (DPDP) Act and international GDPR guidelines, you can exercise full control over your streaming history, watchlist, and personalized recommendation data.
        </p>

        <div class="pt-2 flex items-center gap-3">
            <form action="~/Account/DeleteAccount" method="post" onsubmit="return confirm('Are you sure you want to permanently erase your watch history and account data? This action is irreversible.');">
                <button type="submit" class="px-4 py-2 bg-rose-950/80 hover:bg-rose-900 border border-rose-700/60 text-rose-300 rounded-lg text-xs font-semibold transition-colors flex items-center gap-2">
                    <i class="fa-solid fa-trash-can"></i> Delete Account & Erase Data
                </button>
            </form>
        </div>
    </div>

</div>
