@model List<CinePulse.Mvc.Models.Movie>

@{
    ViewBag.Title = "My Watchlist - Saved Movies";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
                <i class="fa-regular fa-bookmark text-red-500"></i> My Personal Watchlist
            </h1>
            <p class="text-xs text-slate-400 mt-1">
                Movies and blockbusters you've saved for later. Watch anytime in 1080p FHD.
            </p>
        </div>

        <span class="text-xs font-semibold px-3 py-1.5 bg-brand-card border border-brand-border text-slate-300 rounded-lg">
            @Model.Count Saved Titles
        </span>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var movie in Model)
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    }
    else
    {
        <div class="bg-brand-card border border-brand-border rounded-xl p-12 text-center space-y-3">
            <i class="fa-regular fa-bookmark text-4xl text-slate-600"></i>
            <h3 class="text-base font-bold text-white">Your Watchlist is Empty</h3>
            <p class="text-xs text-slate-400">Click the bookmark icon on any movie poster to add it to your watchlist.</p>
            <a href="~/must-watch" class="inline-block mt-2 px-4 py-2 bg-red-600 text-white text-xs font-semibold rounded-lg hover:bg-red-700">
                Browse Must Watch Movies
            </a>
        </div>
    }

</div>
