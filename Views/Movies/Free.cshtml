@model List<CinePulse.Mvc.Models.Movie>

@{
    ViewBag.Title = "Free Full Movies - Unified Global & Indian Catalogue";
    var genres = ViewBag.Genres as List<CinePulse.Mvc.Models.Genre> ?? new List<CinePulse.Mvc.Models.Genre>();
    string selGenre = ViewBag.SelectedGenre ?? "All";
    string selLang = ViewBag.SelectedLanguage ?? "All";
    string selInd = ViewBag.SelectedIndustry ?? "All";
    string q = ViewBag.SearchQuery ?? "";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
    
    <!-- Title Section -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-800 pb-4">
        <div>
            <h1 class="text-2xl sm:text-3xl font-black text-white tracking-tight flex items-center gap-2">
                <i class="fa-brands fa-youtube text-red-500"></i> Free Full-Length Movies
            </h1>
            <p class="text-xs text-slate-400 mt-1">
                Unified entertainment stream: Bollywood, Hollywood & Indian regional cinema together in one single catalogue.
            </p>
        </div>

        <span class="text-xs font-semibold px-3 py-1.5 bg-emerald-950/80 border border-emerald-500/40 text-emerald-300 rounded-lg self-start md:self-auto">
            <i class="fa-solid fa-circle-check text-emerald-400 mr-1"></i> @Model.Count Titles Available Free
        </span>
    </div>

    <!-- Multi-Filter Bar (Industry & Language as query filters, NOT separate tabs) -->
    <form action="~/Movies/Free" method="get" class="bg-brand-card border border-brand-border rounded-xl p-4 space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-3">
            
            <!-- Industry Filter -->
            <div>
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Industry Filter</label>
                <select name="industry" class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-red-500">
                    <option value="All" @(selInd == "All" ? "selected" : "")>All Industries (Unified)</option>
                    <option value="Bollywood" @(selInd == "Bollywood" ? "selected" : "")>Bollywood (Hindi Cinema)</option>
                    <option value="Hollywood" @(selInd == "Hollywood" ? "selected" : "")>Hollywood (International)</option>
                    <option value="Regional" @(selInd == "Regional" ? "selected" : "")>Regional & South Indian</option>
                </select>
            </div>

            <!-- Language Filter -->
            <div>
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Language</label>
                <select name="language" class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-red-500">
                    <option value="All" @(selLang == "All" ? "selected" : "")>All Languages</option>
                    <option value="Hindi" @(selLang == "Hindi" ? "selected" : "")>Hindi</option>
                    <option value="English" @(selLang == "English" ? "selected" : "")>English</option>
                    <option value="Telugu" @(selLang == "Telugu" ? "selected" : "")>Telugu</option>
                    <option value="Malayalam" @(selLang == "Malayalam" ? "selected" : "")>Malayalam</option>
                </select>
            </div>

            <!-- Genre Filter -->
            <div>
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Genre</label>
                <select name="genre" class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-red-500">
                    <option value="All" @(selGenre == "All" ? "selected" : "")>All Genres</option>
                    @foreach (var g in genres)
                    {
                        <option value="@g.Name" @(selGenre.Equals(g.Name, StringComparison.OrdinalIgnoreCase) ? "selected" : "")>@g.Name</option>
                    }
                </select>
            </div>

            <!-- Search Query & Apply Button -->
            <div>
                <label class="block text-[11px] font-semibold uppercase text-slate-400 mb-1">Keyword</label>
                <div class="flex items-center gap-2">
                    <input type="text" name="q" value="@q" placeholder="Title..." 
                           class="w-full bg-slate-900 border border-slate-700 text-xs text-slate-200 rounded-lg px-3 py-2 focus:outline-none focus:border-red-500" />
                    <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-semibold transition-colors">
                        Apply
                    </button>
                </div>
            </div>

        </div>
    </form>

    <!-- Movies Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var movie in Model)
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    }
    else
    {
        <div class="bg-brand-card border border-brand-border rounded-xl p-12 text-center space-y-3">
            <i class="fa-solid fa-film text-4xl text-slate-600"></i>
            <h3 class="text-base font-bold text-white">No Movies Matched Filter</h3>
            <p class="text-xs text-slate-400">Try selecting "All Industries" or clearing search parameters.</p>
            <a href="~/Movies/Free" class="inline-block mt-2 px-4 py-2 bg-red-600 text-white text-xs font-semibold rounded-lg hover:bg-red-700">
                Reset Filters
            </a>
        </div>
    }

</div>
