@model CinePulse.Mvc.Models.MustWatchViewModel

@{
    ViewBag.Title = "Must Watch - Free Bollywood Movies on YouTube";
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    
    <!-- Hero Header Banner -->
    <div class="relative rounded-2xl overflow-hidden bg-gradient-to-r from-red-950 via-slate-900 to-amber-950 border border-red-500/30 p-6 sm:p-10 shadow-2xl">
        <div class="relative z-10 max-w-3xl space-y-4">
            
            <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-600/30 border border-red-500/50 rounded-full text-red-300 text-xs font-bold uppercase tracking-wider">
                <i class="fa-solid fa-fire text-amber-400"></i> Curated Must Watch Collection
            </div>

            <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight leading-tight">
                Must Watch <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-amber-400">Bollywood Blockbusters</span>
            </h1>

            <p class="text-slate-300 text-sm sm:text-base leading-relaxed">
                Stream India's all-time greatest Hindi cinema blockbusters legally for free in 1080p FHD. Every movie is officially verified from studio channels (Red Chillies, Rajshri, Shemaroo, Ultra) with zero playback ID errors. Stream seamlessly on CinePulse or open directly on YouTube in a new tab!
            </p>

            <div class="flex items-center gap-4 pt-2 text-xs text-slate-300 flex-wrap">
                <span class="flex items-center gap-1.5 bg-black/40 px-3 py-1.5 rounded-lg border border-slate-700">
                    <i class="fa-solid fa-circle-check text-emerald-400"></i> Zero Error 150/153 Embeds
                </span>
                <span class="flex items-center gap-1.5 bg-black/40 px-3 py-1.5 rounded-lg border border-slate-700">
                    <i class="fa-brands fa-youtube text-red-500 text-sm"></i> Official Channel Sources
                </span>
                <span class="flex items-center gap-1.5 bg-black/40 px-3 py-1.5 rounded-lg border border-slate-700">
                    <i class="fa-solid fa-arrow-up-right-from-square text-amber-400"></i> Direct New Tab Playback
                </span>
            </div>

        </div>
    </div>

    <!-- Filter & Search Controls Bar -->
    <div class="bg-brand-card border border-brand-border rounded-xl p-4 sm:p-6 space-y-4 shadow-lg">
        
        <!-- Search and Selected Count -->
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
            
            <div class="flex items-center gap-2 text-sm text-slate-300">
                <span class="font-bold text-white text-base">Showing @Model.Movies.Count Movies</span>
                @if (Model.SelectedGenre != "All")
                {
                    <span class="px-2 py-0.5 bg-red-600/20 text-red-400 border border-red-500/30 rounded text-xs">
                        Genre: @Model.SelectedGenre
                    </span>
                }
            </div>

            <!-- In-Page Search Form -->
            <form action="~/must-watch" method="get" class="w-full sm:w-80 flex items-center gap-2">
                <input type="hidden" name="genre" value="@Model.SelectedGenre" />
                <div class="relative w-full">
                    <input type="text" name="q" placeholder="Search Must Watch movies, actors..."
                           value="@Model.SearchQuery"
                           class="w-full pl-9 pr-4 py-2 bg-slate-900 border border-slate-700 rounded-lg text-xs text-white placeholder-slate-400 focus:outline-none focus:border-red-500 focus:ring-1 focus:ring-red-500" />
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-xs text-slate-400"></i>
                </div>
                <button type="submit" class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-semibold shadow transition-colors">
                    Filter
                </button>
            </form>

        </div>

        <!-- Genre Filter Pills with Counts -->
        <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-thin">
            <span class="text-xs text-slate-400 font-semibold whitespace-nowrap mr-1">Filter by Genre:</span>
            
            @foreach (var entry in Model.GenreCounts)
            {
                var isSelected = entry.Key.Equals(Model.SelectedGenre, StringComparison.OrdinalIgnoreCase);
                <a href="~/must-watch?genre=@Server.UrlEncode(entry.Key)&q=@Server.UrlEncode(Model.SearchQuery)"
                   class="px-3 py-1.5 rounded-full text-xs font-medium whitespace-nowrap transition-all flex items-center gap-1.5 @(isSelected ? "bg-red-600 text-white shadow-md shadow-red-900/40" : "bg-slate-900 text-slate-300 hover:bg-slate-800 hover:text-white border border-slate-800")">
                    <span>@entry.Key</span>
                    <span class="text-[10px] px-1.5 py-0.2 rounded-full @(isSelected ? "bg-black/40 text-white" : "bg-slate-800 text-slate-400")">
                        @entry.Value
                    </span>
                </a>
            }
        </div>

    </div>

    <!-- Movies Grid -->
    @if (Model.Movies != null && Model.Movies.Any())
    {
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-6">
            @foreach (var movie in Model.Movies)
            {
                @Html.Partial("_MovieCard", movie)
            }
        </div>
    }
    else
    {
        <div class="bg-brand-card border border-brand-border rounded-xl p-12 text-center space-y-3">
            <i class="fa-solid fa-film text-4xl text-slate-600"></i>
            <h3 class="text-lg font-bold text-white">No Movies Found</h3>
            <p class="text-xs text-slate-400 max-w-md mx-auto">
                No must-watch movies matched your selected genre or query. Try resetting filters to explore all curated titles.
            </p>
            <a href="~/must-watch" class="inline-block mt-2 px-4 py-2 bg-red-600 text-white text-xs font-semibold rounded-lg hover:bg-red-700 transition-colors">
                Reset All Filters
            </a>
        </div>
    }

</div>
